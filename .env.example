# Discord bot token: https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=your_bot_token_here

# Server ID: right-click your server -> Copy Server ID (Developer Mode must be on)
GUILD_ID=123456789012345678

# Channel ID where pings and alerts will be posted
CHANNEL_ID=123456789012345678

# Timezone in IANA format. For Canary Islands use Atlantic/Canary
TIMEZONE=Atlantic/Canary

# Minutes before the hour to ping the assigned user
PRE_PING_MINUTES=5

# Minutes after the hour to check if a refresh was logged
ALERT_DELAY_MINUTES=5

# --- Discord credentials ---

# Discord bot token: https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=your_bot_token_here

# Server ID: right-click your server -> Copy Server ID (Developer Mode must be on)
GUILD_ID=123456789012345678

# Public channel where buff pings are posted
CHANNEL_ID=123456789012345678

# Private channel where /set_link and admin commands work
MANAGEMENT_CHANNEL_ID=123456789012345678

# Private audit log channel (#fountain-logs). Bot writes here, humans only read.
LOGS_CHANNEL_ID=123456789012345678

# Optional. Dedicated channel for blacklist + unban events only (separate from
# the full audit log). If 0, blacklists are still recorded in LOGS_CHANNEL_ID.
BLACKLIST_CHANNEL_ID=123456789012345678

# Category where ticket channels live. The bot only operates inside this category.
TICKET_CATEGORY_ID=123456789012345678

# Role allowed to approve/reject screenshots in tickets
MOD_ROLE_ID=123456789012345678

# Role allowed to use /set_link, /unban and other admin commands
ADMIN_ROLE_ID=123456789012345678

# Developer role (optional). Has the same elevated permissions as ADMIN_ROLE_ID
# (can use /set_link, /unban, etc) and is also protected from being blacklisted.
# Leave at 0 if you don't have a separate developer role.
DEVELOPER_ROLE_ID=123456789012345678

# --- Time settings ---

# Timezone in IANA format. For Canary Islands use Atlantic/Canary
TIMEZONE=Atlantic/Canary

# Minutes before the buff drops to send the pre-alert ping
PRE_PING_MINUTES=5

# Minutes after the buff drops to check if a refresh was logged
ALERT_DELAY_MINUTES=5

# --- Ticket / AFK system ---

# Hours of AFK time each approved refresh grants the user
AFK_HOURS_PER_REFRESH=6

# Max refreshes a single user can stack in one active ticket (4 * 6h = 24h cap)
MAX_REFRESHES_PER_TICKET=4

# Grace period (minutes) after AFK expires before the user is blacklisted
GRACE_MINUTES=10

# Comma-separated minutes-before-expiry to send reminders to the user
PRE_EXPIRY_REMINDERS=30,10,5

# Number of waiting tickets that triggers the "consider second server" alert
QUEUE_ALERT_THRESHOLD=5
